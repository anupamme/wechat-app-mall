.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}
.tip {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 8rpx 24rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.tag {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.8;
}
.label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}
.value {
  flex: 1;
  color: #333;
  word-break: break-all;
}
.kick {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ff4d4f;
  background: #fff1f0;
  border: 2rpx solid #ffccc7;
  border-radius: 36rpx;
}
